# Copie este arquivo para ".env" e ajuste os valores.
PORT=3000
NODE_ENV=production
SITE_URL=https://vida.com.br
SITE_NAME=Vida
# Número do WhatsApp só com dígitos (DDI + DDD + número)
WHATSAPP=5511999999999
CONTACT_EMAIL=contato@vida.com.br
# Usuário administrador criado no PRIMEIRO start (troque a senha depois no painel)
ADMIN_EMAIL=vida
ADMIN_PASSWORD=Troque@123
# Opcional: segredo fixo de sessão (se vazio, é gerado em data/.secret)
SESSION_SECRET=
